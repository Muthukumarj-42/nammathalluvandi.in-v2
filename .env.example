# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# WhatsApp Cloud API Configuration
# Token used to send WhatsApp API messages
WHATSAPP_API_TOKEN="your-whatsapp-api-access-token"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-api-access-token"
# Sender Phone Number ID
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
# Verification Token used during Meta Webhook handshake verification
WHATSAPP_VERIFY_TOKEN="your-custom-webhook-verify-token"

# Razorpay Standard Web Checkout
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

